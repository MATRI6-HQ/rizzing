# ── Secrets — nothing below this heading may ever reach git history ──────────
# Every pattern here has been verified against a file holding a LIVE credential.
# NOTE: gitignore has NO inline comments. A trailing "# ..." becomes part of the
# pattern and silently matches nothing. Keep every comment on its own line.

# VITE_SUPABASE_URL + anon key
.env
.env.local
.env.*.local

# GROQ_API_KEY
supabase/.env.local

# GROQ_API_KEY, GEMINI_API_KEY, SUPABASE_ANON_KEY
supabase/functions/.env

# Supabase CLI local state. NOT just a cache: .temp/pooler-url embeds the
# database password in a postgres:// connection string, plus 3.1MB of
# generated catalog JSON.
supabase/.temp/
supabase/.branches/

# ── Dependencies / build output ──────────────────────────────────────────────
node_modules/
dist/
build/

# ── Native ───────────────────────────────────────────────────────────────────
# Fully regenerable via `npx cap add android` + `npx cap sync`. Deliberately
# untracked: ~3MB of Gradle scaffolding to preserve a 6-line manifest edit is a
# bad trade. THE ONE HAND-EDIT IT CONTAINS — the Supabase deep-link
# intent-filter — is documented verbatim in CLAUDE.md ("Android deep link");
# re-apply it after any regeneration.
android/

# ── Local noise ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
